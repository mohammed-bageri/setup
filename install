#!/usr/bin/env bash
# One-line setup for a new Mac or CachyOS machine:
#   curl -fsSL https://raw.githubusercontent.com/mohammed-bageri/setup/main/install | bash
# Installs git and gh, signs in to GitHub in the browser, clones the private workstation repo
# and runs its ./install. Public file; source: workstation/setup/install.
set -euo pipefail

say() { printf '\033[1m==> %s\033[0m\n' "$*"; }
die() { printf 'setup: %s\n' "$*" >&2; exit 1; }
ask() { local a; read -r -p "$1 [y/N] " a < "$TTY" || a=; [[ $a == [yY]* ]]; }

mac() {
  if ! xcode-select -p >/dev/null 2>&1; then
    say "Installing Apple's command-line tools: finish the window that opens"
    xcode-select --install >/dev/null 2>&1 || true
    until xcode-select -p >/dev/null 2>&1; do sleep 5; done
  fi
  if ! command -v brew >/dev/null; then
    groups | grep -qw admin || die "this Mac account needs admin rights for Homebrew; ask IT, then run this again"
    say "Installing Homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" < "$TTY"
    eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv)"
  fi
  say "Installing git and gh"
  brew install git gh
}

linux() {
  command -v pacman >/dev/null || die "Linux here means CachyOS (pacman)"
  say "Installing git and gh"
  sudo pacman -S --needed --noconfirm git github-cli
}

main() {
  TTY=${WORKSTATION_TTY:-/dev/tty}
  local repo=mohammed-bageri/workstation dir=$HOME/Projects/mohammed-bageri/workstation
  local os=${WORKSTATION_OS:-$(uname -s)}
  case $os in
    Darwin|macos) mac ;;
    Linux|linux) linux ;;
    *) die "unsupported OS: $os" ;;
  esac

  if ! gh auth status >/dev/null 2>&1; then
    say "Signing in to GitHub: approve in the browser with the code shown"
    gh auth login --web --git-protocol https --hostname github.com < "$TTY"
  fi
  gh auth setup-git

  if [[ -d $dir/.git ]]; then
    say "Updating $dir"; git -C "$dir" pull --ff-only
  else
    say "Cloning $repo"; mkdir -p "$(dirname "$dir")"; gh repo clone "$repo" "$dir"
  fi

  if [[ $os == [Ll]inux && -e ${WORKSTATION_BACKUP_BYLABEL:-/dev/disk/by-label}/backup ]] &&
     ask "Backup drive found. Restore your files from it first?"; then
    "$dir/restore"
    git -C "$dir" pull --ff-only   # the backup's copy of the repo may be older
  fi

  say "Running ./install"
  "$dir/install"

  say "Done. Left to do:"
  echo "  - Log out and back in (shell, keyboard and desktop settings)."
  echo "  - Sign in to 1Password, then turn on Settings → Developer → SSH agent."
  [[ $os == [Ll]inux ]] || echo "  - Set the Raycast hotkeys and Finder sidebar: $dir/macos/raycast-hotkeys.md"
}

main "$@"
